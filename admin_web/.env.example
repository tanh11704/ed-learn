# Backend LAN — chỉ gốc host:port (KHÔNG thêm /api hay /api/v1; code tự nối /api/v1/...):
VITE_API_BASE_URL=http://192.168.1.5:8080

# Cùng máy:
# VITE_API_BASE_URL=http://localhost:8080

# Mặc định nếu không có file .env: https://api.phuocanh.me (xem src/config/api.ts)

# Cùng origin + proxy Vite:
# VITE_API_BASE_URL=
# VITE_PROXY_TARGET=http://192.168.1.5:8080

# Danh sách người dùng (admin). Mặc định: /api/v1/admin/users?page=&size=&search=
# VITE_ADMIN_USERS_LIST_PATH=/api/v1/admin/users
